# Copy to .env and fill in. .env is gitignored — never commit a key,
# and never paste one into a notebook cell (outputs get committed).
#
# Free and instant: https://www.eia.gov/opendata/ -> Register
EIA_API_KEY=your_key_here

# Open-Meteo needs no key. Six calls, no registration, CC-BY-4.0.

# ERCOT ancillary prices (OPTIONAL — CAISO works without any of this).
# Free: https://apiexplorer.ercot.com/ -> Sign Up -> Products -> Public API ->
# Subscribe -> Profile -> Show -> copy the Primary key.
# NOTE: the key alone is not enough. Every call also needs a bearer ID token minted
# from the account username and password, which is why all three are listed.
# Leave the three empty unless you have an ERCOT account: a placeholder value makes
# notebook 00 attempt a sign-in with it.
ERCOT_SUBSCRIPTION_KEY=
ERCOT_USERNAME=
ERCOT_PASSWORD=
